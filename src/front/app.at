use calendar_store: CalendarStore
use calendar_util: build_month_grid, month_name

use stylekit.styles: caption_text
style nav_round_btn = "w-10 h-10 rounded-full hover:bg-accent text-foreground font-bold"
style settings_label = "text-xs text-muted-foreground font-medium"
style theme_btn_idle = "flex-1 py-1 px-2 text-xs font-medium rounded-md text-muted-foreground hover:bg-accent border border-border bg-transparent transition-colors"
style theme_btn_active = "flex-1 py-1 px-2 text-xs font-medium rounded-md bg-primary text-primary-foreground transition-colors"
style form_input = "w-full h-9 rounded-md border border-border bg-background px-2.5 text-sm text-foreground outline-none focus:ring-1 focus:ring-primary"
style form_label = "text-xs text-muted-foreground font-medium"

widget App {
    msg {
        PrevMonth,
        NextMonth,
        Today,
        SelectDay(str, int),
        ToggleSettings,
        ToggleDarkMode,
        SetTheme(str),
        SetAccent(str),
        OpenCreate,
        OpenEdit(str, int, str, str, str, str),
        FormTitle(str),
        FormStart(str),
        FormEnd(str),
        FormNotes(str),
        CancelForm,
        SaveForm,
        DeleteEvent(str, int),
    }

    model {
        var dark_mode bool = false
        var accent_color str = "indigo"
        // Plan 448 F: weekday header as a list + for (replacing seven
        // hand-unrolled grid-item lines).
        var weekday_labels = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"]
    }

    // Plan 522: derived grid as computed — month_name / build_month_grid are
    // use-imported module fns; the vue SFC transpiles them into the script
    // (no more ×4 handler recalc chain in the store).
    computed {
        month_label => month_name(.store.month)
        days => build_month_grid(.store.year, .store.month, .store.today, .store.selected_date)
    }

    view {
        col {
            style: "min-h-screen bg-muted/30 p-4 items-center justify-center"
            col {
                style: "w-[448px] p-6 bg-card border border-border rounded-2xl shadow-lg"

                // CALENDAR-001: explicit failure states — no fake data (AC-03).
                if .store.clock_ok == false {
                    col {
                        style: "w-full items-center gap-2 py-8"
                        text "无法获取当前日期" { style: "text-lg font-bold text-destructive" }
                        text f"时钟服务不可用（${.store.store_err}），请检查后端服务后重开应用。" { style: "text-sm text-muted-foreground text-center" }
                    }
                } else {
                    // Header (Nav + Title)
                    row {
                        style: "w-full items-center justify-between"
                        button "<" {
                            onclick: .PrevMonth
                            variant: "ghost"
                            style: nav_round_btn
                        }
                        col {
                            style: "items-center"
                            text .month_label { style: "text-2xl font-bold text-foreground" }
                            text f"${.store.year}" { style: "text-sm text-muted-foreground" }
                        }
                        row {
                            style: "gap-2 items-center"
                            button "Today" {
                                onclick: .Today
                                variant: "ghost"
                                style: "px-3 h-10 rounded-full hover:bg-accent text-foreground text-sm font-semibold"
                            }
                            button ">" {
                                onclick: .NextMonth
                                variant: "ghost"
                                style: nav_round_btn
                            }
                        }
                    }

                    // Store error banner (transient, non-fatal)
                    if .store.store_err != "" {
                        text f"操作失败：${.store.store_err}" { style: "w-full text-xs text-destructive bg-destructive/10 rounded-md px-2 py-1 mt-2" }
                    }

                    // Weekday headers
                    grid {
                        cols: 7
                        gap: 0
                        style: "w-full mt-4"
                        for d in .weekday_labels {
                            grid-item { text d { style: "text-xs font-semibold text-muted-foreground text-center py-2" } }
                        }
                    }

                    // Days Grid
                    grid {
                        cols: 7
                        gap: 0
                        style: "w-full mt-2"
                        for cell in .days {
                            grid-item {
                                button cell.label { variant: "ghost", onclick: .SelectDay(cell.date, cell.ymd), class: cell.cell_class }
                            }
                        }
                    }

                    // Selected-day events (CALENDAR-001 T-03/T-04: backend-attributed)
                    col {
                        style: "w-full mt-4 pt-3 border-t border-border gap-1.5"
                        row {
                            style: "w-full items-center justify-between"
                            text f"${.store.selected_date} 的事件" { style: "text-xs font-semibold text-foreground uppercase tracking-wider" }
                            button "＋ 新建" {
                                onclick: .OpenCreate
                                variant: "ghost"
                                style: "px-2.5 py-1 text-xs font-medium rounded-lg bg-primary/10 text-primary hover:bg-primary/20 transition-colors"
                            }
                        }
                        if .store.day_events.len() == 0 {
                            text "无事件" { style: "text-sm text-muted-foreground py-1" }
                        }
                        for ev in .store.day_events {
                            row {
                                style: "w-full items-center justify-between gap-2 py-1"
                                col {
                                    style: "items-start"
                                    text ev.title { style: "text-sm font-medium text-foreground" }
                                    if ev.notes != "" {
                                        text ev.notes { style: "text-xs text-muted-foreground" }
                                    }
                                }
                                row {
                                    style: "items-center gap-1"
                                    text f"${ev.start} - ${ev.end}" { style: "text-xs text-muted-foreground whitespace-nowrap" }
                                    button "编辑" {
                                        onclick: .OpenEdit(ev.id, .store.store_rev, ev.title, ev.start, ev.end, ev.notes)
                                        variant: "ghost"
                                        style: "px-1.5 py-0.5 text-xs text-muted-foreground hover:text-foreground rounded bg-transparent transition-colors"
                                    }
                                    button "删除" {
                                        onclick: .DeleteEvent(ev.id, .store.store_rev)
                                        variant: "ghost"
                                        style: "px-1.5 py-0.5 text-xs text-destructive hover:bg-destructive/10 rounded bg-transparent transition-colors"
                                    }
                                }
                            }
                        }
                    }

                    // Event form (store-held draft: a failed save keeps input)
                    if .store.form_open {
                        col {
                            style: "w-full mt-3 p-3 border border-border rounded-xl gap-2"
                            if .store.form_mode == "edit" {
                                text "编辑事件" { style: "text-xs font-semibold text-foreground uppercase tracking-wider" }
                            } else {
                                text "新建事件" { style: "text-xs font-semibold text-foreground uppercase tracking-wider" }
                            }
                            col {
                                style: "gap-1"
                                text "标题" { style: form_label }
                                input {
                                    value: .store.f_title
                                    oninput: .FormTitle
                                    placeholder: "事件标题"
                                    style: form_input
                                }
                            }
                            col {
                                style: "gap-1"
                                text "开始（YYYY-MM-DD HH:mm）" { style: form_label }
                                input {
                                    value: .store.f_start
                                    oninput: .FormStart
                                    placeholder: "2026-01-01 09:00"
                                    style: form_input
                                }
                            }
                            col {
                                style: "gap-1"
                                text "结束（YYYY-MM-DD HH:mm）" { style: form_label }
                                input {
                                    value: .store.f_end
                                    oninput: .FormEnd
                                    placeholder: "2026-01-01 10:00"
                                    style: form_input
                                }
                            }
                            col {
                                style: "gap-1"
                                text "备注" { style: form_label }
                                textarea {
                                    value: .store.f_notes
                                    oninput: .FormNotes
                                    placeholder: "备注（可选）"
                                    style: "w-full h-16 rounded-md border border-border bg-background px-2.5 py-1.5 text-sm text-foreground outline-none focus:ring-1 focus:ring-primary resize-none"
                                }
                            }
                            if .store.store_err != "" {
                                text f"保存失败：${.store.store_err}（输入已保留，请修正后重试）" { style: "text-xs text-destructive" }
                            }
                            row {
                                style: "w-full justify-end gap-2 pt-1"
                                button "取消" {
                                    onclick: .CancelForm
                                    variant: "ghost"
                                    style: "px-3 py-1.5 text-xs font-medium rounded-lg text-muted-foreground hover:bg-accent bg-transparent transition-colors"
                                }
                                if .store.form_mode == "edit" {
                                    button "保存修改" {
                                        onclick: .SaveForm
                                        style: "px-3 py-1.5 text-xs font-semibold rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
                                    }
                                } else {
                                    button "保存" {
                                        onclick: .SaveForm
                                        style: "px-3 py-1.5 text-xs font-semibold rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
                                    }
                                }
                            }
                        }
                    }
                }

                // Settings popup (015-notes style)
                if .store.show_settings {
                    col {
                        style: "mt-4 p-3.5 bg-card border border-border rounded-xl gap-3 shadow-lg"
                        row {
                            style: "items-center justify-between"
                            text "Settings" { style: "text-xs font-semibold text-foreground uppercase tracking-wider" }
                            button "✕" {
                                onclick: .ToggleSettings
                                variant: "ghost"
                                style: "text-xs text-muted-foreground hover:text-foreground w-5 h-5 flex items-center justify-center rounded bg-transparent transition-colors"
                            }
                        }
                        col {
                            style: "gap-1.5"
                            text "Theme" { style: settings_label }
                            row {
                                style: "gap-2"
                                if .store.dark_mode {
                                    button "🌙 Dark" {
                                        onclick: .SetTheme("dark")
                                        style: theme_btn_active
                                    }
                                    button "☀ Light" {
                                        onclick: .SetTheme("light")
                                        variant: "ghost"
                                        style: theme_btn_idle
                                    }
                                } else {
                                    button "🌙 Dark" {
                                        onclick: .SetTheme("dark")
                                        variant: "ghost"
                                        style: theme_btn_idle
                                    }
                                    button "☀ Light" {
                                        onclick: .SetTheme("light")
                                        style: theme_btn_active
                                    }
                                }
                            }
                        }
                        col {
                            style: "gap-1.5"
                            text "Accent Color" { style: settings_label }
                            row {
                                style: "items-center gap-3 py-1"
                                button "" { onclick: .SetAccent("indigo"), style: if .store.accent_color == "indigo" { "w-6 h-6 p-0 rounded-full bg-indigo-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-6 h-6 p-0 rounded-full bg-indigo-500 hover:scale-110 transition-transform" } }
                                button "" { onclick: .SetAccent("coral"), style: if .store.accent_color == "coral" { "w-6 h-6 p-0 rounded-full bg-rose-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-6 h-6 p-0 rounded-full bg-rose-500 hover:scale-110 transition-transform" } }
                                button "" { onclick: .SetAccent("ocean"), style: if .store.accent_color == "ocean" { "w-6 h-6 p-0 rounded-full bg-sky-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-6 h-6 p-0 rounded-full bg-sky-500 hover:scale-110 transition-transform" } }
                                button "" { onclick: .SetAccent("sage"), style: if .store.accent_color == "sage" { "w-6 h-6 p-0 rounded-full bg-emerald-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-6 h-6 p-0 rounded-full bg-emerald-500 hover:scale-110 transition-transform" } }
                                button "" { onclick: .SetAccent("amber"), style: if .store.accent_color == "amber" { "w-6 h-6 p-0 rounded-full bg-amber-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-6 h-6 p-0 rounded-full bg-amber-500 hover:scale-110 transition-transform" } }
                            }
                        }
                    }
                }

                // Footer: Settings button in bottom-left + selected date display
                row {
                    style: "w-full items-center justify-between mt-4 pt-3 border-t border-border"
                    button "⚙ Settings" {
                        onclick: .ToggleSettings
                        variant: "ghost"
                        style: if .store.show_settings {
                            "px-2.5 py-1.5 text-xs font-medium rounded-lg bg-accent text-primary transition-colors"
                        } else {
                            "px-2.5 py-1.5 text-xs font-medium rounded-lg text-muted-foreground hover:bg-accent hover:text-foreground bg-transparent transition-colors"
                        }
                    }
                    text f"Selected: ${.store.selected_date}" {
                        style: caption_text
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            store.Init()
            .dark_mode = .store.dark_mode
            .accent_color = .store.accent_color
        }

        .PrevMonth -> {
            store.PrevMonth()
        }

        .NextMonth -> {
            store.NextMonth()
        }

        .Today -> {
            store.Today()
        }

        .SelectDay(date, day_ymd) -> {
            store.SelectDay(date, day_ymd)
        }

        .ToggleSettings -> {
            store.ToggleSettings()
        }

        .ToggleDarkMode -> {
            store.ToggleDarkMode()
            .dark_mode = .store.dark_mode
        }

        .SetTheme(t) -> {
            store.SetTheme(t)
            .dark_mode = .store.dark_mode
        }

        .SetAccent(name) -> {
            store.SetAccent(name)
            .accent_color = .store.accent_color
        }

        .OpenCreate -> {
            store.OpenCreate()
        }

        .OpenEdit(id, expected_rev, title, start, end, notes) -> {
            store.OpenEdit(id, expected_rev, title, start, end, notes)
        }

        .FormTitle(v) -> {
            store.FormTitle(v)
        }

        .FormStart(v) -> {
            store.FormStart(v)
        }

        .FormEnd(v) -> {
            store.FormEnd(v)
        }

        .FormNotes(v) -> {
            store.FormNotes(v)
        }

        .CancelForm -> {
            store.CancelForm()
        }

        .SaveForm -> {
            store.SaveForm()
        }

        .DeleteEvent(id, expected_rev) -> {
            store.DeleteEvent(id, expected_rev)
        }
    }
}
