name: "calendar"
version: "1.0.0"
scene: "ui"
render: "vue"
title: "Calendar"
title_zh: "日历"
# PLAN-056 T-02（auto-os/PLAN-056 主合同反链见 README）：theme 显式键移除
# ——跟随主题链（宿主策略完整快照 > 本 design 默认 > legacy 回退）。显式值
# 会以 pac 优先级压过宿主跟随；原 light 默认改由 app.at design 腿 + store
# dark_mode 默认位（false=浅色）承接（独立运行默认浅色不变）。
accent: "indigo"
window: "fit"

# PLAN-637 T-01b: dep settings 悬空声明移除（common/settings 已迁址 auto-os；
# 本 demo 的 settings 面板为 store 驱动的本地实现，不依赖共享包，自足）。
desktop: "true"

dep stylekit {
    path: "vendor/stylekit"
}

# PLAN-056 T-02：官方主题包正式接入——`vendor/themes` 为 UI 管理渠道发布的
# **固定版本快照**（themes 0.2.0，内容 digest
# 9fa07742dc68aa5377ae06cb2d966386002063f184c515b6c5dddf8a6bef838e，
# 与源包逐文件 sha256 校验等价；不可二次编辑、非第二权威源）。theme 键保持
# 缺省 = follow 语义。品牌 accent（indigo）与外观面板色板豁免不映射。
dep themes {
    path: "vendor/themes"
}
# CALENDAR-001 T-01: split-mode backend (rust service) probed on 17821.
api: "rust"
front_port: 17820
back_port: 17821
